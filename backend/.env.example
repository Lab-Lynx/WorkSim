# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/template_db

# Auth tokens
# Use two DIFFERENT long random strings — never reuse one secret for both.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=your_access_token_secret_here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRES_IN=30d

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Client — the frontend's origin (not the backend's own port).
# Required for CORS + cookies. In production, use the real deployed
# frontend URL.
CLIENT_URL=http://localhost:5173

# Chapa
CHAPA_SECRET_KEY=your_chapa_secret_key_here
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_here
CHAPA_RETURN_URL=http://localhost:5173/billing/return

# Transactional email (Resend). Leave RESEND_API_KEY unset in dev to only log emails.
# RESEND_API_KEY=your_resend_api_key_here
# EMAIL_FROM=WorkSim <onboarding@resend.dev>
# Pending team decision: set the subscription price and currency before enabling checkout.
# CHAPA_PRICE=
# CHAPA_CURRENCY=

# GitHub OAuth and webhooks
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=your_github_token_encryption_key_here
GITHUB_REQUESTED_SCOPE=repo,write:repo_hook
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# AI providers
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
# Optional fallback keys, tried in order when a key is rate limited, out of quota or rejected.
# Mentor chat and ticket generation can use separate keys; both fall back to the shared
# GEMINI_API_KEY / GEMINI_API_KEY_2 after their own keys.
# GEMINI_API_KEY_2=
# GEMINI_MENTOR_API_KEY=
# GEMINI_MENTOR_API_KEY_2=
# GEMINI_TICKET_API_KEY=
# GEMINI_TICKET_API_KEY_2=
# GROQ_API_KEY_2=
# Pending team decision: choose provider model names for this deployment.
# GEMINI_MODEL=
# GROQ_MODEL=

# Server-side mentor abuse limits. Override per deployment if product limits change.
MENTOR_MESSAGE_MAX_CHARS=4000
MENTOR_MESSAGES_PER_TICKET=20
MENTOR_MESSAGE_WINDOW_MS=86400000
AI_TICKET_MAX_INPUT_BYTES=2000000
# VERIFICATION_TOKEN_EXPIRES_IN=
# PASSWORD_RESET_TOKEN_EXPIRES_IN=
# SUBMISSION_CI_TIMEOUT_MS=
# SUBMISSION_EVALUATOR_TIMEOUT_MS=
# AI_REQUEST_TIMEOUT_MS=
# BRANCH_NAME_PREFIX=

# Only set this if frontend and backend share a parent domain in production
# (e.g. api.example.com / app.example.com). Leave unset otherwise.
# COOKIE_DOMAIN=.example.com

# Error tracking (optional). Leave SENTRY_DSN unset to disable Sentry entirely.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0

# Prometheus scrape token (optional, min 16 chars). /metrics returns 404 until this is set.
# Scrape with: Authorization: Bearer <METRICS_TOKEN>
# METRICS_TOKEN=
